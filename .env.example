# Copy this file to .env for local Compose use. Replace every placeholder
# before exposing the services beyond your own machine.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

WEB_PORT=8080
# Per-file upload limit in bytes; parser and proxy limits cap this at 25 MiB.
DATASET_MAX_FILE_SIZE_BYTES=26214400

# Private S3-compatible dataset storage (local RustFS service).
DATASET_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=cloudetl-datasets
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://rustfs:9000
AWS_S3_ADDRESSING_STYLE=path
RUSTFS_ROOT_ACCESS_KEY=CLOUDETL_ROOT
RUSTFS_ROOT_SECRET_KEY=replace-with-a-unique-random-object-store-root-secret
RUSTFS_APP_ACCESS_KEY=CLOUDETL_APP
RUSTFS_APP_SECRET_KEY=replace-with-a-separate-random-object-store-app-secret

# PostgreSQL bootstrap administrator (used only during first volume init).
POSTGRES_DB=cloudetl
POSTGRES_ADMIN_USER=cloudetl_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-random-password

# Runtime Django role: owner of the app database, with migration rights.
POSTGRES_APP_USER=cloudetl_app
POSTGRES_APP_PASSWORD=replace-with-another-unique-random-password
DB_SSLMODE=prefer

# Enable these and configure TLS at the trusted proxy before production use.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
